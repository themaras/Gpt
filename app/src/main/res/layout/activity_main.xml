<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Poker Capture" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Stopped" android:textSize="18sp" android:layout_marginTop="18dp" />
    <TextView android:id="@+id/frames" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Frames saved: 0" android:textSize="18sp" android:layout_marginTop="10dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AI model" android:textSize="16sp" android:layout_marginTop="18dp" />
    <RadioGroup android:id="@+id/aiGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <RadioButton android:id="@+id/aiChatGpt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ChatGPT" />
        <RadioButton android:id="@+id/aiGemini" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gemini" />
        <RadioButton android:id="@+id/aiClaude" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claude" />
    </RadioGroup>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Screenshot half" android:textSize="16sp" android:layout_marginTop="18dp" />
    <RadioGroup android:id="@+id/cropGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <RadioButton android:id="@+id/cropLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Left" />
        <RadioButton android:id="@+id/cropRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Right" />
        <RadioButton android:id="@+id/cropTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top" />
        <RadioButton android:id="@+id/cropBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bottom" />
    </RadioGroup>
    <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ENABLE AUTO-SEND / SAME CHAT" android:layout_marginTop="18dp" />
    <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="START CAPTURE" android:layout_marginTop="28dp" />
    <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="STOP" android:layout_marginTop="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Prototype: captures the screen and saves a frame when the table region changes. For hand review/study after play."
        android:layout_marginTop="24dp" />
</LinearLayout>
